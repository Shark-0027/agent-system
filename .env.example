# OpenAI 兼容 API 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# MCP Server 配置
MCP_SERVER_TIMEOUT=30
MCP_MAX_RETRIES=3

# Agent Runtime 配置
AGENT_MAX_STEPS=15
AGENT_MAX_TIME_SECONDS=600
AGENT_ENABLE_TRACE=true
AGENT_TRACE_DIR=./traces

# Planner-Executor 配置
PLANNER_MAX_SUBTASKS=20
PLANNER_ENABLE_AUTO_PLAN=true
EXECUTOR_MAX_WORKERS=4